# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
# If empty or unreachable, MediaForge automatically runs in local in-memory mode
DATABASE_URL=postgresql://mediaforge:mediaforge123@localhost:5432/mediaforge

# Storage Settings
STORAGE_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Processing Simulation
ENABLE_MOCK_PROCESSING=true
PROCESSING_DELAY_MS=2000
